    <string name="lmu_plugin_dialog_message_prompt">SimAnalyzer can use LMU&apos;s built-in shared memory when it is available. This setup installs the official rF2 shared memory compatibility plugin only for systems where that fallback is needed, validates the archive and DLL, and updates LMU&apos;s plugin configuration for you.</string>
    <string name="lmu_plugin_dialog_message_installing">SimAnalyzer is downloading the official LMU shared memory plugin and updating the game configuration. Keep Le Mans Ultimate closed until setup finishes.</string>
    <string name="lmu_plugin_dialog_message_success">The official shared memory plugin is installed and Le Mans Ultimate is now ready for SimAnalyzer telemetry.</string>
    <string name="lmu_plugin_dialog_message_failure">SimAnalyzer could not finish the automatic setup. This flow does not patch game executables, install services, or add startup tasks. It only places the shared memory DLL and updates LMU&apos;s plugin configuration.</string>
    <string name="lmu_plugin_dialog_message_missing_game">SimAnalyzer could not find Le Mans Ultimate in your Steam libraries, so it cannot place the official shared memory plugin automatically.</string>
